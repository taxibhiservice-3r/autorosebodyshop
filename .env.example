# -- Production domain ---------------------------------------------------------
# Used for sitemap, canonical URLs, OG metadata, and schema @id anchors
NEXT_PUBLIC_SITE_URL=https://www.blueroseautobodyrepair.com

# -- Google Search Console verification ---------------------------------------
# Get from GSC ? Settings ? Ownership verification ? HTML tag method
# Looks like: ABCDEFG1234567hijklmn
GOOGLE_SITE_VERIFICATION=

# -- Bing Webmaster Tools verification ----------------------------------------
# Get from Bing WMT ? Add Site ? Meta tag ? content value only
BING_SITE_VERIFICATION=

# -- IndexNow (fast Bing/Yandex indexing) -------------------------------------
# Key is: blueroseautobody2025indexnow8f4d
# Key file already deployed at: /blueroseautobody2025indexnow8f4d.txt
INDEXNOW_KEY=blueroseautobody2025indexnow8f4d

# -- IndexNow API auth (optional — protects POST /api/indexnow) ----------------
# Set this to any strong secret. Include as: Authorization: Bearer <value>
# Trigger from Vercel deploy hook: https://<domain>/api/indexnow
INDEXNOW_SECRET=

# -- Form submission (contact + quote forms) -----------------------------------
# Options: Resend, SendGrid, Formspree endpoint, etc.
# RESEND_API_KEY=
# CONTACT_EMAIL=info@blueroseautobodyrepair.com
